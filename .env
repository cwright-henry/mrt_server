# Logging
# error: 0, warn: 1, info: 2, verbose: 3, debug: 4, silly: 5
# e.g. info level will log everything below so info, warn and error
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=true
LOG_ENABLE_ELASTICSEARCH=false
LOG_LEVEL=info
LOG_FILE=mrt.log
LOG_DIR=logs

